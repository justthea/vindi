# Copy to .env and fill in. Never commit .env: the repo is public.

# You.com API key (https://you.com/platform). Used for Search, Contents and Research.
YDC_API_KEY=

# LLM used to label hits and write drafts.
# LLM_PROVIDER=anthropic  -> Anthropic Messages API
# LLM_PROVIDER=openai     -> any OpenAI-compatible chat completions endpoint (set LLM_BASE_URL to change host)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
# LLM_BASE_URL=

# Optional tuning
# SEARCH_COUNT=10            results per query (max 100)
# EXTRACTION_MODE=highlights highlights | full_page | none
# MAX_QUERIES=12
# RESEARCH_EFFORT=standard   lite (<10s, no JSON schema) | standard (10-30s) | deep

# Development only: run with canned data and no keys. Never demo in this mode.
# MOCK=1
